-- =====================================================================
-- MAUDE Ingestion - 07_backfill_fanout.sql
-- Parallel backfill via disjoint task lanes (bucketed by time period).
--
-- Rendered from 07_backfill_fanout.sql.j2 with load_scope = {{ load_scope }}
--
-- Rationale: SP_MAUDE_INGEST is single-node Python (HTTP download +
-- ijson parse), so a larger warehouse does NOT speed a single lane.
-- Parallelism comes from MANY lanes on XSMALL - cheap and effective.
-- Each lane runs BACKFILL with a disjoint QUARTER_LIKE regex; the proc
-- is idempotent and skips already-LOADED partitions, so lanes never
-- collide and reruns are safe.
--
-- Bucketing (measured lesson): tail latency is bound by the single
-- biggest lane running serially within itself. Heavy recent years are
-- therefore split PER QUARTER, not per year, so the largest lane is
-- ~1 quarter (~6 files) instead of ~1 year (~24). Lighter/older years
-- stay grouped. If you hit serverless-task concurrency limits, coarsen
-- the recent-year buckets back toward year-level (e.g. '2019q%').
--
-- Run as {{ engineer_role }} (needs EXECUTE MANAGED TASK - see 00_setup.sql).
--
-- WARNING - buckets MUST stay disjoint. Each lane does
-- DELETE WHERE _partition -> COPY FORCE, which is NOT atomic across lanes.
-- If two running lanes match the same partition you get either duplicate
-- rows (both COPY after both DELETE) or a silently emptied partition whose
-- ledger still says LOADED (one lane cancelled between its DELETE and COPY).
-- So do NOT launch an additional lane whose pattern overlaps one already
-- running - to re-shard, cancel the in-flight lanes first:
--   SELECT SYSTEM$USER_TASK_CANCEL_ONGOING_EXECUTIONS('<db>.RAW.TASK_MAUDE_BF_n');
-- then re-run. Verify with the per-partition reconciliation query below.
-- =====================================================================

USE ROLE {{ engineer_role }};
USE WAREHOUSE {{ warehouse }};
USE DATABASE {{ db() }};
USE SCHEMA RAW;

-- Launch all lanes: creates one XSMALL serverless task per bucket and
-- fires it immediately. QUARTER_LIKE accepts a regex (alternation).
DECLARE
  buckets ARRAY := ARRAY_CONSTRUCT(
{%- if load_scope == 'full' %}
    -- FULL HISTORY (1993-2026): older/lighter years grouped
    '(1991|1992|1993|1994|1995|1996|1997|1998|1999|2000|2001|2002|2003|2004)q%',
    '(2005|2006|2007|2008)q%',
    '(2009|2010)q%',
    '(2011|2012)q%',
    '2013q%', '2014q%', '2015q%', '2016q%', '2017q%', '2018q%',
{%- elif load_scope == 'last_10_years' %}
    -- LAST 10 YEARS (2016+)
    '(2016|2017|2018)q%',
{%- elif load_scope == 'last_5_years' %}
    -- LAST 5 YEARS (2021+)
{%- endif %}
{%- if load_scope in ['full', 'last_10_years'] %}
    -- heavy recent years: split PER QUARTER to flatten the tail
    '2019q1%', '2019q2%', '2019q3%', '2019q4%',
    '2020q1%', '2020q2%', '2020q3%', '2020q4%',
    '2021q1%', '2021q2%', '2021q3%', '2021q4%',
    '2022q1%', '2022q2%', '2022q3%', '2022q4%',
{%- else %}
    -- 2021-2022 are heavy (~56 partitions combined), so split PER QUARTER
    -- here too. Grouping them into one '(2021|2022)q%' lane made that single
    -- lane the tail: 56 partitions serially vs ~7 for every other lane.
    '2021q1%', '2021q2%', '2021q3%', '2021q4%',
    '2022q1%', '2022q2%', '2022q3%', '2022q4%',
{%- endif %}
    '2023q1%', '2023q2%', '2023q3%', '2023q4%',
    '2024q1%', '2024q2%', '2024q3%', '2024q4%',
    '2025q1%', '2025q2%', '2025q3%', '2025q4%',
    '2026q1%', '2026q2%', '2026q3%', '2026q4%',
    'all_other%'   -- openFDA bucket for records without a valid quarter
  );
  i INT;
  b STRING;
BEGIN
  FOR i IN 0 TO ARRAY_SIZE(buckets) - 1 DO
    b := buckets[i]::string;
    EXECUTE IMMEDIATE
      'CREATE OR REPLACE TASK {{ db() }}.RAW.TASK_MAUDE_BF_' || i ||
      ' USER_TASK_MANAGED_INITIAL_WAREHOUSE_SIZE = ''XSMALL''' ||
      ' USER_TASK_TIMEOUT_MS = 86400000' ||
      ' SUSPEND_TASK_AFTER_NUM_FAILURES = 0' ||
      ' AS CALL {{ db() }}.RAW.SP_MAUDE_INGEST(''BACKFILL'', 0, ''' || b || ''')';
    EXECUTE IMMEDIATE 'EXECUTE TASK {{ db() }}.RAW.TASK_MAUDE_BF_' || i;
  END FOR;
  RETURN 'launched ' || ARRAY_SIZE(buckets) || ' backfill lanes (scope: {{ load_scope }})';
END;

